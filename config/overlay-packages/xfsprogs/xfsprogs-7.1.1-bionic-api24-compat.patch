+/*
+ * hasmntopt equivalents usable on Bionic API < 26, where the function is not
+ * declared (and from API 26 the glibc-style delimiter semantics apply).
+ * Both scan opts as a comma-delimited token list and honor the same match
+ * rules as hasmntopt: a full option token, terminated by '\0', ',' or '='.
+ */
+static inline char *
+mnt_opts_find(const char *opts, const char *opt)
+{
+	size_t		len = strlen(opt);
+	char		*s = (char *)opts;
+
+	while (s && *s) {
+		if (strncmp(s, opt, len) == 0 &&
+		    (s[len] == '\0' || s[len] == '='))
+			return s;
+		s = strchr(s, ',');
+		if (s)
+			s++;
+	}
+	return NULL;
+}
+
+static inline int
+mnt_opts_has(const char *opts, const char *opt)
+{
+	return mnt_opts_find(opts, opt) != NULL;
+}
+/*
+ * Bionic exposes getsubopt() only from API level 26; Termux targets API 24,
+ * where the symbol exists in libc but no header declares it.  Provide a
+ * POSIX-semantics fallback for that case.
+ */
+#if defined(__ANDROID__) && __ANDROID_API__ < 26
+static inline int
+getsubopt(char **optionp, char *const *tokens, char **valuep)
+{
+	char		*seg = *optionp;
+	char		*p = seg;
+	int		i;
+
+	while (*p != '\0' && *p != ',')
+		p++;
+	for (i = 0; tokens[i] != NULL; i++) {
+		size_t	tlen = strlen(tokens[i]);
+		size_t	len = (size_t)(p - seg);
+
+		if (tlen <= len && strncmp(seg, tokens[i], tlen) == 0 &&
+		    (tlen == len || seg[tlen] == '=')) {
+			if (tlen == len)
+				*valuep = NULL;
+			else
+				*valuep = seg + tlen + 1;
+			break;
+		}
+	}
+	if (*p == ',') {
+		*p = '\0';
+		p++;
+	}
+	if (tokens[i] == NULL) {
+		i = -1;
+		/* POSIX: report the whole option segment as the value. */
+		*valuep = seg;
+	}
+	*optionp = p;
+	return i;
+}
+#endif /* defined(__ANDROID__) && __ANDROID_API__ < 26 */
+
+#if defined(__ANDROID__)
+/*
+ * Bionic does not declare the legacy valloc() interface at any API level.
+ * xfs_db's debug allocator uses it for page-aligned allocations.
+ */
+static inline void *
+valloc(size_t size)
+{
+	return memalign(sysconf(_SC_PAGESIZE), size);
+}
+#endif
+
+/*
+ * Bionic gates getpwent()/setpwent() behind API 26 and does not export those
+ * symbols in the API 24 NDK sysroot, so linking against API 24 fails.  The
+ * pwd.h/grp.h companions (endpwent, getgrent, setgrent, endgrent) already
+ * exist there as static inline no-op stubs and must NOT be redeclared.
+ * Provide trivial stubs: iteration over /etc/passwd is meaningless on
+ * Android (no traditional user DB).
+ */
+#if defined(__ANDROID__) && __ANDROID_API__ < 26
+static inline struct passwd *getpwent(void) { return NULL; }
+static inline void setpwent(void) { }
+#endif
+
+/*
+ * Bionic gains syncfs() (declaration and libc symbol) only at API 28; older
+ * sysroots must reach the kernel syscall directly. __NR_syncfs exists since
+ * Linux 2.6.39, so the syscall is available on all supported kernels.
+ */
+#if defined(__ANDROID__) && __ANDROID_API__ < 28
+#include <sys/syscall.h>
+#include <unistd.h>
+static inline int syncfs(int fd)
+{
+	return syscall(__NR_syncfs, fd);
+}
+#endif
+
+/*
+ * Bionic ships no sync_file_range() wrapper at any API level; go straight to
+ * the kernel syscall like glibc's implementation does.
+ */
+#if defined(__ANDROID__)
+#include <sys/syscall.h>
+#include <unistd.h>
+static inline int sync_file_range(int fd, long long offset, long long nbytes,
+				  unsigned int flags)
+{
+	return syscall(__NR_sync_file_range, fd, offset, nbytes, flags);
+}
+#endif
+
+#if defined(__ANDROID__)
+/*
+ * Bionic never declares or exports quotactl(); issue the syscall directly.
+ * All supported ABIs use the generic argument order for __NR_quotactl.
+ */
+#include <sys/syscall.h>
+#include <unistd.h>
+static inline int quotactl(int cmd, const char *special, int id, void *addr)
+{
+	return syscall(__NR_quotactl, cmd, special, id, addr);
+}
+#endif
