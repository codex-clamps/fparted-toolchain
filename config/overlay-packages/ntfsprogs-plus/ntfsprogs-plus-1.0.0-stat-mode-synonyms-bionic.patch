--- a/include/compat.h
+++ b/include/compat.h
@@ -68,6 +68,25 @@
 extern int ffs(int i);
 extern int ffsl(long i);
 
+/* Bionic's <sys/stat.h> only provides the legacy S_IREAD/S_IWRITE/S_IEXEC
+ * synonyms under __USE_BSD/__USE_GNU, which nothing defines in a plain
+ * Termux build; glibc and macOS define them unconditionally, which is why
+ * host builds never notice. Derive them from their canonical counterparts
+ * whenever they are absent: the #ifndef guards make this a no-op where the
+ * traditional names exist, and an identical redefinition of an object-like
+ * macro is valid C everywhere else. */
+#ifndef S_IREAD
+#define S_IREAD S_IRUSR
+#endif
+
+#ifndef S_IWRITE
+#define S_IWRITE S_IWUSR
+#endif
+
+#ifndef S_IEXEC
+#define S_IEXEC S_IXUSR
+#endif
+
 #ifndef HAVE_DAEMON
 extern int daemon(int nochdir, int noclose);
 #endif /* HAVE_DAEMON */
