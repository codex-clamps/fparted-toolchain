-#ifndef HAVE_FFS
+/* Android's Bionic exports ffs()/ffsl() from libc but exposes no
+ * declarations for them through its headers, so configure detects the
+ * symbols (HAVE_FFS) while callers are left without prototypes, which
+ * clang rejects. Declare both here unconditionally: an identical
+ * redeclaration is valid C wherever the platform does declare them. */
 extern int ffs(int i);
-#endif /* HAVE_FFS */
+extern int ffsl(long i);
 
 #ifndef HAVE_DAEMON
 extern int daemon(int nochdir, int noclose);
